{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ASC Screen Analyzer",
  "version": "0.1.0",
  "identifier": "com.callesjoberg.asc-screen-analyzer",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ASC - Skärmklipp & Analys",
        "width": 1024,
        "height": 768,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/*"
    ]
  }
}
