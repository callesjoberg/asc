{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    "allow-list-windows",
    "allow-list-monitors",
    "allow-select-folder",
    "allow-start-capture",
    "allow-stop-capture",
    "allow-get-capture-status",
    "allow-run-offline-analysis"
  ]
}
